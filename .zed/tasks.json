// https://zed.dev/docs/tasks
[
  {
    "label": "Run VHSh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "uv",
    "args": [
      "run",
      "vhsh", "run",
      "--midi-mapping", "src/vhsh/midi_mappings/korg_nanoKONTROL2.toml",
      "src/vhsh/scenes/*.glsl",
    ]
  },
  {
    "label": "Run VHSh (verbose)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "uv",
    "args": [
      "run",
      "vhsh",
      "--verbose",
      "run",
      "--midi-mapping", "src/vhsh/midi_mappings/korg_nanoKONTROL2.toml",
      "src/vhsh/scenes/*.glsl",
    ]
  },
  {
    "label": "ruff watch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "uv",
    "args": [
      "run",
      "ruff",
      "check",
      "--watch",
    ]
  },
  {
    "label": "ty watch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "uv",
    "args": [
      "run",
      "ty",
      "check",
      "--watch",
    ]
  },
  {
    "label": "Lint (all)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "command": "sh",
    "args": [
      "-c",
      "'uv sync --dev --extra all && uv run ruff check && uv run ty check && uv run vulture && uv run pytest'"
    ]
  },
]
